FROM node:24-alpine AS tester

WORKDIR /app
COPY package.json ./
RUN npm i

ENV NEXT_TELEMETRY_DISABLED=1
COPY . .

ENV NODE_ENV=test \
    NEXT_TELEMETRY_DISABLED=1

WORKDIR /app

RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs

USER nextjs

CMD ["npm", "run", "test"]
